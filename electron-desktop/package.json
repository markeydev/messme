{
  "name": "messme-electron-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Messme desktop client (Electron)",
  "main": "main.js",
  "author": "markeydev",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "build:win": "electron-builder --win portable nsis --publish never",
    "build:win:portable": "electron-builder --win portable --publish never",
    "build:win:installer": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "41.2.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.markeydev.messme.desktop",
    "productName": "Messme Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Messme-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Messme",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    }
  }
}
