generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  username        String             @unique
  email           String             @unique
  passwordHash    String
  avatarUrl       String?
  bio             String?
  clipMeBio       String?
  linkedMessmeChannelId String?
  isVerified      Boolean            @default(false)
  isBadgeVerified Boolean            @default(false)
  isAdmin         Boolean            @default(false)
  isBlocked       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  chatMemberships ChatMember[]
  chats           Chat[]
  sentMessages    Message[]
  messageReactions MessageReaction[]
  sessions        Session[]
  pushSubscriptions PushSubscription[]
  channelMessages  ChannelMessage[]
  gameRoomRoleMemberships GameRoomRoleMember[]
  stories          Story[]
  storyViews       StoryView[]
  storyLikes       StoryLike[]
  clipMeVideos     ClipMeVideo[]
  clipMeLikes      ClipMeLike[]
  clipMeComments   ClipMeComment[]
  clipMeReposts    ClipMeRepost[]
  clipMeViews      ClipMeView[]
  clipMeCommentLikes ClipMeCommentLike[]
  clipMeFollowing  ClipMeSubscription[] @relation("ClipMeFollowing")
  clipMeFollowers  ClipMeSubscription[] @relation("ClipMeFollowers")
  adminPanelTokens AdminPanelLinkToken[]

  @@map("users")
}

model AdminPanelLinkToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("admin_panel_link_tokens")
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   // 'email_verify' | 'password_reset'
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
  @@map("verification_codes")
}

model Chat {
  id        String       @id @default(cuid())
  title     String?
  isGroup   Boolean      @default(false)
  isPersonalChannel Boolean @default(false)
  gameMode  Boolean      @default(false)
  avatarUrl String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  ownerId   String?
  members   ChatMember[]
  owner     User?        @relation(fields: [ownerId], references: [id])
  messages  Message[]
  channels  Channel[]
  roles     GameRoomRole[]

  @@map("chats")
}

model ChatMember {
  id       String   @id @default(cuid())
  chatId   String
  userId   String
  joinedAt DateTime @default(now())
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_members")
}

model Message {
  id                    String      @id @default(cuid())
  chatId                String
  senderId              String
  encryptedContent      String
  createdAt             DateTime    @default(now())
  isEdited              Boolean     @default(false)
  replyToId             String?
  forwardedFromUsername String?
  isForwarded           Boolean     @default(false)
  audioDuration         Int?
  audioUrl              String?
  type                  MessageType @default(TEXT)
  fileName              String?
  fileSize              Int?
  fileUrl               String?
  videoNoteUrl          String?
  videoNoteDuration     Int?
  chat                  Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyTo               Message?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies               Message[]   @relation("MessageReplies")
  sender                User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions             MessageReaction[]

  @@index([chatId])
  @@index([senderId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  FILE
  VIDEO_NOTE
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Channel {
  id        String           @id @default(cuid())
  chatId    String
  name      String
  type      ChannelType      @default(TEXT)
  position  Int              @default(0)
  createdAt DateTime         @default(now())
  chat      Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messages  ChannelMessage[]

  @@index([chatId])
  @@map("channels")
}

model ChannelMessage {
  id             String   @id @default(cuid())
  channelId      String
  senderId       String
  senderUsername String
  content        String
  replyToId      String?
  createdAt      DateTime @default(now())
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        ChannelMessage?  @relation("ChannelMessageReplies", fields: [replyToId], references: [id])
  replies        ChannelMessage[] @relation("ChannelMessageReplies")

  @@index([channelId])
  @@index([replyToId])
  @@map("channel_messages")
}

enum ChannelType {
  TEXT
  VOICE
}

model GameRoomRole {
  id                String               @id @default(cuid())
  chatId            String
  name              String
  color             String               @default("#8b97ff")
  position          Int                  @default(0)
  isDefault         Boolean              @default(false)
  canMoveMembers    Boolean              @default(false)
  canChangeAvatar   Boolean              @default(false)
  canRenameChannels Boolean              @default(false)
  createdAt         DateTime             @default(now())
  chat              Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  members           GameRoomRoleMember[]

  @@unique([chatId, name])
  @@index([chatId, position])
  @@map("game_room_roles")
}

model GameRoomRoleMember {
  id        String       @id @default(cuid())
  roleId    String
  userId    String
  createdAt DateTime     @default(now())
  role      GameRoomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@index([userId])
  @@map("game_room_role_members")
}

model Story {
  id            String      @id @default(cuid())
  userId        String
  mediaUrl      String
  mediaType     StoryMediaType
  videoDuration Int?
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views         StoryView[]
  likes         StoryLike[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId])
  @@map("story_views")
}

model StoryLike {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
  @@map("story_likes")
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

model ClipMeVideo {
  id          String         @id @default(cuid())
  userId      String
  videoUrl    String
  description String         @default("")
  privacy     ClipMePrivacy  @default(PUBLIC)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       ClipMeLike[]
  comments    ClipMeComment[]
  reposts     ClipMeRepost[]
  views       ClipMeView[]

  @@index([userId, createdAt])
  @@index([privacy, createdAt])
  @@map("clipme_videos")
}

model ClipMeLike {
  id        String      @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime    @default(now())
  video     ClipMeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@map("clipme_likes")
}

model ClipMeComment {
  id        String      @id @default(cuid())
  videoId   String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime    @default(now())
  video     ClipMeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    ClipMeComment? @relation("ClipMeCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ClipMeComment[] @relation("ClipMeCommentThread")
  likes     ClipMeCommentLike[]

  @@index([videoId, createdAt])
  @@index([videoId, parentId, createdAt])
  @@index([parentId])
  @@index([userId, createdAt])
  @@map("clipme_comments")
}

model ClipMeCommentLike {
  id        String        @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime      @default(now())
  comment   ClipMeComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@index([commentId])
  @@map("clipme_comment_likes")
}

model ClipMeRepost {
  id        String      @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime    @default(now())
  video     ClipMeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([userId])
  @@map("clipme_reposts")
}

model ClipMeView {
  id        String      @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime    @default(now())
  video     ClipMeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([videoId])
  @@index([userId])
  @@map("clipme_views")
}

model ClipMeSubscription {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("ClipMeFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("ClipMeFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("clipme_subscriptions")
}

enum ClipMePrivacy {
  PUBLIC
  FOLLOWERS
  PRIVATE
}
